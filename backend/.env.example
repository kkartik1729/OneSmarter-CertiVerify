
# Generate a unique key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ENV=development
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# In production, enable HTTPS redirects and configure the trusted proxy header/IPs.
DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SECURE_PROXY_HEADER=HTTP_X_FORWARDED_PROTO
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,10.0.0.0/8
# DJANGO_HSTS_SECONDS=31536000
# Set this shared PostgreSQL cache table once per database with:
# python manage.py createcachetable
# Database configuration (PostgreSQL is default; set DB_ENGINE=sqlite for local quick testing)
# DB_ENGINE=sqlite
DB_NAME=certiverify_db
DB_USER=certiverify_dev
DB_PASSWORD=YOUR_LOCAL_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Local development prints email messages and OTPs in the Django terminal.
# For SMTP testing, switch to django.core.mail.backends.smtp.EmailBackend and
# provide your own authorized development credentials (never production ones).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CertiVerify Local <certiverify-local@example.test>
SERVER_EMAIL=certiverify-local@example.test
EMAIL_REPLY_TO=certiverify-local@example.test
FRONTEND_URL=http://localhost:5173

# Optional Google OAuth web client id. Configure only an authorized dev client.
GOOGLE_CLIENT_ID=

# Optional public frontend URL used in certificate email verification links.
# In production, set this to your deployed frontend URL, for example:
# PUBLIC_FRONTEND_URL=https://certiverify.onesmarter.com
PUBLIC_FRONTEND_URL=

# Additional CORS origins (comma-separated), e.g. for production frontend:
# CORS_ALLOWED_ORIGINS=https://certiverify.onesmarter.com
CORS_ALLOWED_ORIGINS=
# Explicit trusted origins for Django's CSRF middleware (production only).
CSRF_TRUSTED_ORIGINS=
