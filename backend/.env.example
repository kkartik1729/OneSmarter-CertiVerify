
DJANGO_SECRET_KEY=replace-with-a-secure-django-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

DB_NAME=certiverify_db
DB_USER=postgres
DB_PASSWORD=YOUR_ACTUAL_POSTGRES_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=5432

# Central SMTP configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.ionos.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
EMAIL_HOST_USER=akshay.kumar@onesmarter.com
EMAIL_HOST_PASSWORD=YOUR_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=OneSmarter Support <support@onesmarter.com>
SERVER_EMAIL=support@onesmarter.com
EMAIL_REPLY_TO=help@onesmarter.com
FRONTEND_URL=http://localhost:5173

# Public website URL used for LinkedIn Credential verification links.
# In development, leave blank so the system warns that localhost cannot be used for LinkedIn.
# In production, set this to your deployed HTTPS website domain, for example:
# PUBLIC_FRONTEND_URL=https://certiverify.onesmarter.com
PUBLIC_FRONTEND_URL=

# Additional CORS origins (comma-separated), e.g. for production frontend:
# CORS_ALLOWED_ORIGINS=https://certiverify.onesmarter.com
CORS_ALLOWED_ORIGINS=
