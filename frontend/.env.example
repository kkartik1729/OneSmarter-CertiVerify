# Vite proxies /api to Django, so the same frontend config works on desktop and LAN devices.
VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://127.0.0.1:8005
VITE_CERTIFICATE_GENERATION_TIMEOUT_MS=60000
VITE_BULK_GENERATION_TIMEOUT_MS=120000

# Google OAuth 2.0 Client ID (optional, for Google Sign-In)
# VITE_GOOGLE_CLIENT_ID=
