# Local development: Vite proxies /api to Django.
# Production builds must set VITE_API_BASE_URL to the deployed backend's HTTPS
# API origin (for example https://api.example.com/api); Vercel SPA fallback
# intentionally excludes /api so backend requests can never receive index.html.
VITE_API_BASE_URL=/api
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_TIMEOUT_MS=15000
VITE_CERTIFICATE_GENERATION_TIMEOUT_MS=60000
VITE_BULK_GENERATION_TIMEOUT_MS=120000
VITE_TEMPLATE_UPLOAD_TIMEOUT_MS=60000
VITE_CSV_VALIDATION_TIMEOUT_MS=60000

# Google OAuth 2.0 Client ID (optional, for Google Sign-In)
# VITE_GOOGLE_CLIENT_ID=
